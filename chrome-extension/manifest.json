{
  "manifest_version": 3,
  "name": "划词发送到背单词",
  "description": "选中英文单词或短语，右键翻译并保存到本机背单词词库。",
  "version": "1.1.0",
  "key": "",
  "permissions": [
    "activeTab",
    "contextMenus",
    "nativeMessaging",
    "notifications",
    "scripting",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "划词发送到背单词"
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
